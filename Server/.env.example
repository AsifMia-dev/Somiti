# PostgreSQL connection string. Copy this file to .env and replace the values.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/somiti?schema=public"

# Server environment example
PORT=5000
NODE_ENV=development

# JWT and session
JWT_SECRET=change-me
SESSION_SECRET=change-me

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend URL to redirect after OAuth
CLIENT_URL=http://localhost:3000
