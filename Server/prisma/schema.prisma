generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Manager {
  id            String @id @default(uuid()) @db.Uuid
  name     String
  email         String   @unique
  phone         String?
  password_hash String
  created_at    DateTime @default(now())
  somiti        Somiti?
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model Somiti {
  id                    String @id @default(uuid()) @db.Uuid
  name                  String          @unique
  created_at            DateTime        @default(now())
  collection_day        Weekday         @default(THURSDAY)
  monthly_collection_date Int           @default(5) 
  owner_manager_id      String @db.Uuid           @unique
  owner_manager         Manager         @relation(fields: [owner_manager_id], references: [id], onDelete: Cascade)
  borrowers             Borrower[]
  finance               SomitiFinance?

  @@index([owner_manager_id])
}

model Borrower {
  id              String @id @default(uuid()) @db.Uuid
  full_name       String
  phone           String?
  nid_number      String       
  father_name     String?
  village_address String?
  photo_url       String?
  created_at      DateTime      @default(now())
  somiti_id       String @db.Uuid
  somiti          Somiti        @relation(fields: [somiti_id], references: [id], onDelete: Cascade)
  loans           Loan[]
  installments    Installment[]

  @@index([somiti_id])
  @@unique([nid_number, somiti_id])
}

enum LoanStatus {
  ACTIVE
  PAID
  COMPLETED
}

enum Frequency {
  WEEKLY
  MONTHLY
}
enum LoanType {
  NEW
  TOP_UP
}

model Loan {
  id             String @id @default(uuid()) @db.Uuid
  loan_type      LoanType
  loan_amount    Decimal    @db.Decimal(12, 2)
  interest_rate  Decimal    @db.Decimal(5, 2)
  total_installment  Int
  completed_installment Int @default(0)                         
  frequency      Frequency  @default(WEEKLY)
  created_at     DateTime   @default(now())
  borrower_id    String @db.Uuid
  borrower       Borrower   @relation(fields: [borrower_id], references: [id], onDelete: Cascade)
  installments   Installment[]
  account        LoanAccount?

  @@index([borrower_id])
}

model LoanAccount {
  id               String @id @default(uuid()) @db.Uuid
  installment_amount Decimal @db.Decimal(12, 2)   // shaptahik kisti er poriman
  collected_amount Decimal  @db.Decimal(12, 2) @default(0)
  savings        Decimal    @db.Decimal(12, 2) @default(0)
  due_amount       Decimal  @db.Decimal(12, 2)
  fine             Decimal  @db.Decimal(12, 2) @default(0)
  status           LoanStatus @default(ACTIVE)
  loan_id          String @unique @db.Uuid
  loan             Loan     @relation(fields: [loan_id], references: [id], onDelete: Cascade)
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

model Installment {
  id                 String @id @default(uuid()) @db.Uuid
  installNo          Int
  due_date           DateTime @db.Date
  installment_amount Decimal           @db.Decimal(12, 2)
  status             InstallmentStatus @default(PENDING)
  fine_amount        Decimal           @db.Decimal(12, 2) @default(0)
  collected_at       DateTime?
  borrower_id        String @db.Uuid
  borrower           Borrower          @relation(fields: [borrower_id], references: [id], onDelete: Cascade)
  loan_id            String @db.Uuid
  loan               Loan              @relation(fields: [loan_id], references: [id], onDelete: Cascade)

  @@index([borrower_id])
  @@index([loan_id])
}

model SomitiFinance {
  id                      String @id @default(uuid()) @db.Uuid
  cash_balance            Decimal  @db.Decimal(12, 2) @default(0)
  total_interest_earned   Decimal  @db.Decimal(12, 2) @default(0)
  loan_balance            Decimal  @db.Decimal(12, 2) @default(0)
  total_fines_collected   Decimal  @default(0)
  total_fines_outstanding Decimal  @default(0)
  somiti_id               String @unique @db.Uuid
  somiti                  Somiti   @relation(fields: [somiti_id], references: [id], onDelete: Cascade)
}