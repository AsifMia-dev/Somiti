generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Manager {
  id            Int      @id @default(autoincrement())
  name     String
  email         String   @unique
  phone         String?
  password_hash String
  created_at    DateTime @default(now())
  somiti        Somiti?
}

model Somiti {
  id                 Int           @id @default(autoincrement())
  name               String        @unique
  created_at         DateTime      @default(now())
  owner_manager_id   Int           @unique
  owner_manager      Manager       @relation(fields: [owner_manager_id], references: [id], onDelete: Cascade)
  borrowers          Borrower[]
  finance            SomitiFinance?

  @@index([owner_manager_id])
}

enum LoanStatus {
  ACTIVE
  PAID
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

model Borrower {
  id              Int           @id @default(autoincrement())
  full_name       String
  phone           String?
  nid_number      String        @unique
  father_name     String?
  village_address String?
  photo_url       String?
  created_at      DateTime      @default(now())
  somiti_id       Int
  somiti          Somiti        @relation(fields: [somiti_id], references: [id], onDelete: Cascade)
  loans           Loan[]
  installments    Installment[]

  @@index([somiti_id])
}

model Loan {
  id                        Int           @id @default(autoincrement())
  principal_amount          Decimal       @db.Decimal(12, 2)
  total_installment         Int
  weekly_installment_amount Decimal       @db.Decimal(12, 2)
  status                    LoanStatus    @default(ACTIVE)
  created_at                DateTime      @default(now())
  accumulation              Decimal       @db.Decimal(12, 2)
  borrower_id               Int
  borrower                  Borrower      @relation(fields: [borrower_id], references: [id], onDelete: Cascade)
  installments              Installment[]

  @@index([borrower_id])
}

model Installment {
  id                 Int               @id @default(autoincrement())
  week_number        Int
  installment_amount Decimal           @db.Decimal(12, 2)
  status             InstallmentStatus @default(PENDING)
  fine_amount        Decimal           @db.Decimal(12, 2) @default(0)
  is_fine_paid       Boolean           @default(false)
  collected_at       DateTime?
  due_amount         Decimal           @db.Decimal(12, 2)
  borrower_id        Int
  borrower           Borrower          @relation(fields: [borrower_id], references: [id], onDelete: Cascade)
  loan_id            Int
  loan               Loan              @relation(fields: [loan_id], references: [id], onDelete: Cascade)

  @@index([borrower_id])
  @@index([loan_id])
}

model SomitiFinance {
  id           Int      @id @default(autoincrement())
  net_worth    Decimal  @db.Decimal(12, 2)
  cash_balance Decimal  @db.Decimal(12, 2)
  loan_balance Decimal  @db.Decimal(12, 2)
  total_fines  Decimal  @db.Decimal(12, 2)
  somiti_id    Int      @unique
  somiti       Somiti   @relation(fields: [somiti_id], references: [id], onDelete: Cascade)
}